# Public entry point: HTTPS (Let's Encrypt, automatic). DOMAIN is the VM's sslip.io name,
# e.g. 3-110-25-7.sslip.io (no domain purchase needed).
#
# The demo is open, with no login, so reviewers can start straight away. Spending is protected
# in the services themselves: per-visitor rate limits and a budget cap per service (see
# guard.py / guard.ts and the *_BUDGET_USD settings). To require a login again, add
# `import protected` to each site below and put a basic_auth line in deploy/auth.caddy.

(protected) {
	# /health stays open so uptime checks work; it reveals nothing and costs nothing.
	@private not path /health
	basic_auth @private {
		import /etc/caddy/auth.caddy
	}
}

# Shared routes on every host, so any page can use them without cross-origin requests:
# Claude usage from all three services (the usage bar), and speech to text (the mic buttons).
(suite_routes) {
	# Demo accounts: sign in / out / who am I, from any host (kb/session.py sets the cookie
	# for the parent domain, so one sign-in covers all three services).
	handle_path /_auth/* {
		rewrite * /auth{uri}
		reverse_proxy knowledge-brain:8001
	}
	# A demo, not a product: keep it out of search engines.
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
"
	}
	handle_path /_speech {
		request_body {
			max_size 12MB
		}
		rewrite * /transcribe
		reverse_proxy knowledge-brain:8001 {
			header_up X-API-Key {$KB_API_KEY}
		}
	}
	handle_path /_usage/kb {
		rewrite * /usage
		reverse_proxy knowledge-brain:8001 {
			header_up X-API-Key {$KB_API_KEY}
		}
	}
	handle_path /_usage/inbox {
		rewrite * /api/usage
		reverse_proxy inbox-agent:8002
	}
	handle_path /_usage/scope {
		rewrite * /api/usage
		reverse_proxy scope-builder:8003
	}
	handle /_usage/budget {
		header Content-Type application/json
		respond `{"budget_usd": {$SITE_BUDGET_USD}}`
	}
}

# Hub page: what each service does and what to try first.
{$DOMAIN} {
	import suite_routes
	handle {
		root * /srv/site
		file_server
	}
}

kb.{$DOMAIN} {
	import suite_routes
	handle {
		reverse_proxy knowledge-brain:8001 {
			# Visitors have already passed the login above, so the browser UI shouldn't ask for
			# the API key as well: the proxy adds it. Through the proxy, the login guards the API;
			# the key still guards the service from anything else on the server's network.
			header_up X-API-Key {$KB_API_KEY}
		}
	}
}

inbox.{$DOMAIN} {
	import suite_routes
	handle {
		reverse_proxy inbox-agent:8002
	}
}

scope.{$DOMAIN} {
	import suite_routes
	handle {
		reverse_proxy scope-builder:8003
	}
}
