{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "knowledge-brain",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "task1-knowledge-brain",
        "uvicorn",
        "kb.api:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "inbox-agent",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "task2-inbox-agent",
        "run",
        "start"
