# Copy to .env and fill in. Never commit .env.

# Claude runs on Amazon Bedrock. Without a region (and AWS credentials) every service still
# starts, but answering (Task 1), drafting (Task 2) and scope building (Task 3) are off.
# Enable the Claude models for your account in the Bedrock console (Model access) first.
# Defaults: Opus 4.6 (answers), Sonnet 4.6 (drafts, scopes), Haiku 4.5 (rewrites, triage).
CLAUDE_PROVIDER=bedrock
AWS_REGION=ap-southeast-2
# Inference profile prefix added to bare model names: global (default), au, us, eu, jp, apac.
# Any *_MODEL setting can also be a full Bedrock id, e.g. au.anthropic.claude-opus-4-6-v1.
CLAUDE_BEDROCK_PROFILE=au
# Credentials, one of:
# - a Bedrock bearer token (short-term, from aws-bedrock-token-generator):
# AWS_BEARER_TOKEN_BEDROCK=
# - or AWS access keys / a profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# - or nothing here at all on EC2/ECS with a role that allows bedrock:InvokeModel and bedrock:InvokeModelWithResponseStream.
#
# To use Anthropic's own API instead: CLAUDE_PROVIDER=anthropic and ANTHROPIC_API_KEY=...

# Shared secret: the Inbox Agent and Scope Builder send it to the Knowledge Brain.
KB_API_KEY=change-me

# Optional: knowledge-base snapshot to start from. Defaults to the published GitHub
# release, so the first start takes seconds instead of a ~40 minute crawl and index.
# KB_SEED_URL=

# Optional overrides (defaults in each task's config):
# KB_ANSWER_MODEL=claude-opus-4-6
# KB_VISION_MODEL=claude-haiku-4-5
# INBOX_CLASSIFY_MODEL=claude-haiku-4-5
# INBOX_DRAFT_MODEL=claude-sonnet-4-6
# INBOX_AUTONOMY_THRESHOLD=20
# SCOPE_HOURLY_RATE=35
# SCOPE_CURRENCY=USD

# Optional: Connect Gmail in the Inbox Agent (docs/GMAIL_SETUP.md). Type these yourself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
