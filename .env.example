# Copy to .env and fill in. Never commit .env.

# Claude API key. Without it every service still starts, but answering (Task 1),
# drafting (Task 2) and scope building (Task 3) are switched off.
ANTHROPIC_API_KEY=

# Shared secret: the Inbox Agent and Scope Builder send it to the Knowledge Brain.
KB_API_KEY=change-me

# Optional: knowledge-base snapshot to start from. Defaults to the published GitHub
# release, so the first start takes seconds instead of a ~40 minute crawl and index.
# KB_SEED_URL=

# Optional overrides (defaults in each task's config):
# KB_ANSWER_MODEL=claude-opus-5-5
# KB_VISION_MODEL=claude-haiku-5-5
# INBOX_CLASSIFY_MODEL=claude-haiku-5-5
# INBOX_DRAFT_MODEL=claude-sonnet-5-5
# INBOX_AUTONOMY_THRESHOLD=20
# SCOPE_HOURLY_RATE=35
# SCOPE_CURRENCY=USD
